    {
      "id": "MY44qRjYaAHBTDW5j8Owv",
      "type": "text",
      "x": 480.756410718831,
      "y": 6419.226359587901,
      "width": 995.5436401367188,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dashed",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bBi",
      "roundness": null,
      "seed": 1628433743,
      "version": 341,
      "versionNonce": 1294520687,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1759859521582,
      "link": null,
      "locked": false,
      "text": "Apesar de tudo, ainda não chegamos na grande qualidade\nde usar Controle de Versão...",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Apesar de tudo, ainda não chegamos na grande qualidade\nde usar Controle de Versão...",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Mxika7mWtDTABDfGehj0E",
      "type": "text",
      "x": 505.8698002970638,
      "y": 6607.032035436209,
      "width": 962.531494140625,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "dashed",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bBj",
      "roundness": null,
      "seed": 2009996961,
      "version": 484,
      "versionNonce": 1779092367,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1759859521582,
      "link": null,
      "locked": false,
      "text": "Permitir trabalhos consistes e controlados, sem \"zona\",\nestando você sozinho ou em equipe!",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Permitir trabalhos consistes e controlados, sem \"zona\",\nestando você sozinho ou em equipe!",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "hUR-osFNjNfuc4c6Mxyip",
      "type": "text",
      "x": 470.5193963007495,
      "y": 6818.163957332914,
      "width": 1118.267578125,
      "height": 135,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bBk",
      "roundness": null,
      "seed": 1629665345,
      "version": 329,
      "versionNonce": 686326191,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1759859521582,
      "link": null,
      "locked": false,
      "text": "E mais importante: permite trabalhos e alterações em paralelo! \nVocê e outras pessoas podem trabalhar sem medo de \"bagunçar\"\nos arquivos e misturar mudanças!",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "E mais importante: permite trabalhos e alterações em paralelo! \nVocê e outras pessoas podem trabalhar sem medo de \"bagunçar\"\nos arquivos e misturar mudanças!",
      "autoResize": true,
      "lineHeight": 1.25
    },
