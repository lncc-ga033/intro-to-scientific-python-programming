      "link": null,
      "locked": false,
      "text": "Até que se chega em um\nponto que a pessoa faz\nsua última modificação\npara cumprir seu trabalho.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Até que se chega em um\nponto que a pessoa faz\nsua última modificação\npara cumprir seu trabalho.",
      "autoResize": true,
      "lineHeight": 1.25
    },
