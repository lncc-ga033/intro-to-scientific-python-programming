      "isDeleted": false,
      "boundElements": null,
      "updated": 1759859521583,
      "link": null,
      "locked": false,
      "text": "Diferentes pessoas podem ter feito clones\nem diferentes momentos! E o que define isso?",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Diferentes pessoas podem ter feito clones\nem diferentes momentos! E o que define isso?",
