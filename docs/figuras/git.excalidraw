    {
      "id": "zFETq30JcYrJVWI-eVqCB",
      "type": "text",
      "x": 543.4444725829449,
      "y": 12511.485027308674,
      "width": 1286.8194580078125,
      "height": 270,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#fa5252",
      "fillStyle": "solid",
