      "roundness": null,
      "seed": 682676559,
      "version": 208,
      "versionNonce": 857051311,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1759859521583,
      "link": null,
      "locked": false,
      "text": "Lembrando que é uma boa prática sincronizar as mudanças locais com o remoto!\nEsse processo se chama \"pushing\", ou simplesmente fazer um \"push\".",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Lembrando que é uma boa prática sincronizar as mudanças locais com o remoto!\nEsse processo se chama \"pushing\", ou simplesmente fazer um \"push\".",
      "autoResize": true,
      "lineHeight": 1.25
    },
