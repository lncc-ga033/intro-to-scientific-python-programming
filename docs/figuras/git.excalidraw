      "seed": 1230654273,
      "version": 641,
      "versionNonce": 2049044847,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1759859515275,
      "link": null,
      "locked": false,
      "text": "Como o merge do fb-add-something\nocorre em um ponto com mudanças\nque ele não viu, pode ser necessário\nresolver conflitos aqui. Ou seja,\ndefinir o que entra ou não, etc.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Como o merge do fb-add-something\nocorre em um ponto com mudanças\nque ele não viu, pode ser necessário\nresolver conflitos aqui. Ou seja,\ndefinir o que entra ou não, etc.",
      "autoResize": true,
      "lineHeight": 1.25
    },
