      "seed": 2102699489,
      "version": 230,
      "versionNonce": 817348111,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1759859521583,
      "link": null,
      "locked": false,
      "text": "Considerando que o trabalho está finalizado no fb-add-feature,\nagora a pessoa precisa colocar suas mudanças no main!\nMas o main deve ser o main remoto, para ficar disponível para todos!",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Considerando que o trabalho está finalizado no fb-add-feature,\nagora a pessoa precisa colocar suas mudanças no main!\nMas o main deve ser o main remoto, para ficar disponível para todos!",
      "autoResize": true,
      "lineHeight": 1.25
    },
