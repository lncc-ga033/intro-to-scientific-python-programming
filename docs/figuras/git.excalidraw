      "type": "text",
      "x": 467.87547187150216,
      "y": 11109.604392518344,
      "width": 1200.8515625,
      "height": 135,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
