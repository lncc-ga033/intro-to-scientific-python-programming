    {
      "id": "L4NZcXzpIu2V0Dft4um-l",
      "type": "text",
      "x": 1776.3274672446998,
      "y": 5444.712321109597,
      "width": 346.8797607421875,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
