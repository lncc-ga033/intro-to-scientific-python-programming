    },
    {
      "id": "b599a-nVgF6xE5f3T7PwG",
      "type": "text",
      "x": 536.7782689164272,
      "y": 8780.76249255223,
      "width": 426.663818359375,
      "height": 105,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bGl",
      "roundness": null,
      "seed": 985475777,
      "version": 249,
      "versionNonce": 671068815,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1759859521583,
      "link": null,
      "locked": false,
      "text": "Todo o histórico dos arquivos\nvirá junto no clone, mesmo de\ncoisas que já nem existem mais!",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Todo o histórico dos arquivos\nvirá junto no clone, mesmo de\ncoisas que já nem existem mais!",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "Wo-z9F_IjfVvJzAJPqnZK",
      "type": "text",
      "x": 415.1270249535274,
      "y": 8929.276929841875,
      "width": 1224.7913818359375,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bGm",
      "roundness": null,
      "seed": 398848687,
      "version": 272,
      "versionNonce": 1168672943,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1759859521583,
      "link": null,
      "locked": false,
      "text": "Nesse ponto, a pessoa deseja adicionar algo aos arquivos/códigos.\nPara toda mudança, deve ser criado um novo branch/ramo localmente! ",
      "fontSize": 36,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Nesse ponto, a pessoa deseja adicionar algo aos arquivos/códigos.\nPara toda mudança, deve ser criado um novo branch/ramo localmente! ",
      "autoResize": true,
      "lineHeight": 1.25
    },
