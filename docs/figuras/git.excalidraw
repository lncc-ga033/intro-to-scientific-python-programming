    {
      "id": "Q_Jl_yjPByx4NUL88ezFr",
      "type": "text",
      "x": 446.1111863385856,
      "y": 10608.69884105367,
      "width": 1380.0595703125,
      "height": 90,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "hachure",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
